APP_NAME="Triador aiia"
ENVIRONMENT=local
DATABASE_URL=sqlite:///./triador.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# mock = teste local sem IA real | gemini = Google Gemini | openai = OpenAI
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=COLE_SUA_CHAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-2.5-flash

# OpenAI opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gere uma chave longa e única em produção
SECRET_KEY=troque-por-uma-chave-longa-e-segura
